@using Why.Controllers


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OPTR</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/Create.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Why_Did_S.I.H._Die.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Detail.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/prem.css" asp-append-version="true" />
     
</head>
<body>


    <header>
        <h1>OPTR</h1>
        <div class="header-buttons">
            <ul class="">

                @if (ViewBag.userCount != null)
                {

                    <li class="nav-item">
                        <a class="login" asp-area="" asp-controller="Admin" asp-action="Index">Admin</a>
                    </li>
                    <li class="nav-item">
                        <a class="login" asp-area="" asp-controller="Login" asp-action="Logout">Logout</a>
                    </li>

                }
                else
                {

                    <li class="nav-item ">
                        <a class="login" asp-area="" asp-controller="Login" asp-action="Login">Sign in</a>
                    </li>
                    <li class="nav-item ">
                        <a class="signup" asp-controller="Account" asp-action="Register">Sign Up</a>
                    </li>
                }
            </ul>
        </div>
    </header>

    <div class="container">
        
        <div class="content" id="content">
            @RenderBody()
            
        </div>
    </div>

    <footer>
        <p>&copy; 2025 Oyun Platformu. Tüm hakları saklıdır.</p>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
