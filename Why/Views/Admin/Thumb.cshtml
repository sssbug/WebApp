@using Why.Data.Models
@model List<Category>
@{
	ViewData["Title"] = "Thumb";
	Layout = "~/Views/Shared/_Admin.cshtml";
}


<main role="main" class="pb-3">
	<div class="login-box">
		<h2>Game</h2>
		<form method="post">
			<input type="hidden" name="ThumbClass" value="@ViewBag.thumbClassName" required="">
			<div class="user-box">

				<input class="Inp" type="text" name="ThumbName" required="">
				<label>Name</label>

			</div>
			<div class="user-box">

				<input class="Inp" type="text" name="ThumbLastName" required="">
				<label>LastName</label>

			</div>
			<div>
				<h4 class="title">Type</h4>


				<div class="chosen">
					
					@foreach (var item in Model)
					{
						<label>
							<input type="radio" name="ThumbTag" value="@item.CategoryName" required="">
							<span>@item.CategoryName</span>
						</label>
					}

					
					
					

				</div>
			</div>
			<div class="user-box">
				<h4 class="title">Day of Death</h4>
				<input type="date" name="Date" required="">


			</div>
			<div>
				<input class="next" type="submit" value="Next" name="submit">
			</div>
		</form>
	</div>
</main>

