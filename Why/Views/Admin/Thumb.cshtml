@using Why.Data.Models
@model List<Category>
@{
	ViewData["Title"] = "Thumb";
	Layout = "~/Views/Shared/_Create.cshtml";
}


<main role="main" class="pb-3">
	<div class="login-box">
		<h2>Game</h2>
		<form method="post">
			<input type="hidden" name="ThumbClass" value="@ViewBag.thumbClassName" required="">
			<div class="user-box">

				<input class="Inp" type="text" name="ThumbName" required="">
				<label>Name</label>

			</div>
			<div class="user-box">

				<input class="Inp" type="text" name="ThumbLastName" required="">
				<label>LastName</label>

			</div>
			<div>
				<h4 class="title">Type</h4>


				<div class="chosen">
					
					@foreach (var item in Model)
					{
						
						<div class="checkbox-item">
							<input type="checkbox" name="ThumbTag" value="@item.CategoryName">
							<span>@item.CategoryName</span>
						</div>
					}

					
					
					

				</div>
			</div>
			
			<div class="form-group">
				<label for="death-date">Day of Death</label>
				<input type="date" id="death-date" name="death-date">
			</div>


			



			<!-- Next butonu -->
			<button class="next-button" type="submit" value="Next" name="submit">Next</button>
		</form>
	</div>
</main>

