<div class="main-content">
	<h2>Latest Featured Games</h2>
	<div class="game-list">

		@foreach (var item in Model)
		{


			<div class="game-item">
				<a asp-controller="Home" asp-action="Detail" asp-route-id="@item.ThumbId">
					<div>
						<h5>@item.ThumbName @item.ThumbLastName</h5>
						<span>@item.Date.Day:@item.Date.Month:@item.Date.Year</span>
						<h6>@item.ThumbTag</h6>
					</div>
				</a>
			</div>



		}
	</div>
	
</div>


<script>
	function toggleSidebar() {
		const sidebar = document.getElementById('sidebar');
		sidebar.classList.toggle('collapsed');
	}
</script>
